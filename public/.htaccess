# ==============================================================================
# Hostinger Apache / LiteSpeed Web Hosting Configuration for Aishu Foods SPA
# ==============================================================================

# Ensure index.html is served as the default directory index
DirectoryIndex index.html

# Prevent directory browsing (returns 403 if no index file exists)
Options -Indexes

# Follow symbolic links (required for mod_rewrite on many Apache/LiteSpeed hosts)
Options +FollowSymLinks

# SPA Fallback Routing
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Don't rewrite if request is already index.html
  RewriteRule ^index\.html$ - [L]

  # Don't rewrite if requested file, directory, or symlink exists
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d [OR]
  RewriteCond %{REQUEST_FILENAME} -l
  RewriteRule ^ - [L]

  # Route all other URLs to index.html for client-side routing
  RewriteRule . /index.html [L]
</IfModule>

# Enable GZIP compression for text, scripts, styles, and JSON
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Browser Caching Headers for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresDefault "access plus 2 days"
</IfModule>
