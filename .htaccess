# ==============================================================================
# Hostinger Apache / LiteSpeed Web Hosting Configuration for Aishu Foods SPA
# ==============================================================================

# Ensure index.html is served as the default directory index
DirectoryIndex index.html

# Prevent directory browsing (returns 403 if no index file exists)
Options -Indexes

# Follow symbolic links (required for mod_rewrite on many Apache/LiteSpeed hosts)
Options +FollowSymLinks

# Strict MIME Types
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType text/css .css
  AddType image/jpeg .jpg .jpeg
  AddType image/png .png
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType image/x-icon .ico
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

# SPA Fallback Routing
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Don't rewrite if request is already index.html
  RewriteRule ^index\.html$ - [L]

  # Don't rewrite if requested file or symlink exists
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -l
  RewriteRule ^ - [L]

  # Don't rewrite if requested directory actually contains index.html (e.g. root /)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^ - [L]

  # Never rewrite missing static assets (images, fonts, scripts, styles) to index.html
  # This prevents HTML fallback on broken image requests which causes Hostinger CDN 422 errors
  RewriteCond %{REQUEST_URI} \.(?:css|js|jpe?g|png|gif|ico|webp|svg|woff2?|ttf|eot)$ [NC]
  RewriteRule ^ - [R=404,L]

  # Route all other URLs to index.html for client-side routing
  RewriteRule . /index.html [L]
</IfModule>

# Enable GZIP compression for text, scripts, styles, and JSON
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Browser Caching Headers for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresDefault "access plus 2 days"
</IfModule>
