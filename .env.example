# ==============================================================================
# AISHU HOME FOODS — ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure your environment credentials.
#
# IMPORTANT SECURITY RULES:
# - VITE_* variables are bundled into client javascript and visible in the browser.
# - NEVER put secret service_role keys, database passwords, or provider secrets here!
# - Staging builds (VITE_APP_ENV=staging) are strictly guarded against connecting
#   to the Production Supabase project.
# ==============================================================================

# Supabase Public Configuration (Required)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Application Environment Mode (development | staging | production)
VITE_APP_ENV=staging

# Razorpay Payment Gateway — Public Client Key ID (Safe in frontend)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# ==============================================================================
# SERVER-SIDE ONLY SECRETS (Configure in Supabase Dashboard > Edge Function Secrets)
# DO NOT put these in frontend code or commit to GitHub!
# ==============================================================================
# RAZORPAY_KEY_ID=rzp_test_your_key_id_here
# RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
# RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
# NIMBUSPOST_EMAIL=your_nimbus_email
# NIMBUSPOST_PASSWORD=your_nimbus_password
# NIMBUSPOST_API_KEY=your_nimbus_api_key
# NIMBUSPOST_WEBHOOK_SECRET=your_nimbus_webhook_secret
