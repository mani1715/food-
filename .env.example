# ==============================================================================
# AISHU HOME FOODS — ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================
# Copy this file to .env and configure your production credentials.
#
# IMPORTANT:
# - VITE_* variables are bundled into client javascript and visible in the browser.
# - NEVER put secret service role keys, database passwords, or payment secrets here!
# ==============================================================================

# Supabase Public Configuration (Required)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Application Environment Mode (development | production)
VITE_APP_ENV=development

# Razorpay Payment Gateway — Public Client Key ID (Safe in frontend)
VITE_RAZORPAY_KEY_ID=rzp_live_TrDR6q1ML16dKa

# ==============================================================================
# SERVER-SIDE ONLY SECRETS (Configure in Supabase Dashboard > Edge Function Secrets)
# DO NOT put these in frontend code or commit to GitHub!
# ==============================================================================
